---
// Preenchimento labial, dia a dia: a partir do carrossel da própria Dra. ("O que esperar depois do
// preenchimento labial?"). Foto dela aplicando num card + as fases em cards de tom claro com o desenho de
// traço dos lábios, cada vez menos inchados (como nas artes dela).
// A fase "Dias 1 e 2" não está nas artes recebidas (falta o slide 1); o texto é o que as outras fases deixam
// implícito. Confirmar com a Dra.
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import foto from "../assets/img/labial-aplicacao.jpg";
import { whatsappProcedimento } from "../config/site";

// Altura do lábio de cima e de baixo (px no viewBox 240x150), do mais inchado ao resultado final.
const FASES = [
  { quando: "Dias 1 e 2", titulo: "Inchou? É normal.", texto: "Lábios mais inchados e, às vezes, pequenos roxos. Faz parte do processo.", cima: 54, baixo: 68, cor: "coral" },
  { quando: "Dias 3 a 7", titulo: "Desinchando.", texto: "O inchaço já diminui bastante e o formato começa a aparecer.", cima: 44, baixo: 57, cor: "peach" },
  { quando: "Dias 9 e 10", titulo: "Fase do amor.", texto: "Você se apaixona pelos novos lábios. Tem gente que até sente falta de mais inchaço.", cima: 36, baixo: 48, cor: "lilac" },
  { quando: "A partir de 14 dias", titulo: "O resultado real.", texto: "Inchaço e roxos já passaram. Agora dá para avaliar o efeito do preenchimento.", cima: 31, baixo: 42, cor: "sage" },
];

const Y = 76;
const labios = (a: number, b: number) => ({
  cima: `M14 ${Y} C 50 ${Y - 6} 72 ${Y - a} 100 ${Y - a} C 109 ${Y - a} 115 ${Y - a + 6} 120 ${Y - a + 10} C 125 ${Y - a + 6} 131 ${Y - a} 140 ${Y - a} C 168 ${Y - a} 190 ${Y - 6} 226 ${Y}`,
  baixo: `M14 ${Y} C 52 ${Y + b * 0.3} 78 ${Y + b} 120 ${Y + b} C 162 ${Y + b} 188 ${Y + b * 0.3} 226 ${Y}`,
  boca: `M20 ${Y} C 64 ${Y + 4} 96 ${Y - 3} 120 ${Y + 1} C 144 ${Y - 3} 176 ${Y + 4} 220 ${Y}`,
});
---

<section id="labial" class="band bg-blush-wash" aria-labelledby="labial-titulo">
  <div class="wrap flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
    <div>
      <h2 id="labial-titulo" class="h-section max-w-[13ch] md:max-w-none">Preenchimento labial, dia a dia</h2>
      <p class="lead mt-4 max-w-[34rem] md:mt-5">
        O resultado aparece em etapas. Saber o que é normal em cada fase deixa a recuperação bem mais tranquila.
      </p>
    </div>
    <a href={whatsappProcedimento("preenchimento labial")} target="_blank" rel="noopener" class="btn-line">
      Quero fazer meu labial
      <Icon name="arrowUpRight" class="size-[1.1rem]" />
    </a>
  </div>

  <div class="fases wrap mt-8 grid gap-3.5 md:mt-10 md:gap-4">
    <div class="f-foto media relative bg-[#f2b8b0]">
      <Picture
        src={foto}
        formats={["avif", "webp"]}
        widths={[380]}
        sizes="(min-width: 1280px) 17rem, (min-width: 640px) 45vw, 92vw"
        alt="Dra. Rychelly de jaleco branco e luvas, aplicando o preenchimento nos lábios com uma seringa"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[50%_30%]"
      />
    </div>
    <ol class="contents">
      {
        FASES.map((f, i) => {
          const p = labios(f.cima, f.baixo);
          return (
            <li class="card flex flex-col p-5 md:p-6" style={`background:var(--soft-${f.cor})`}>
              <span class="flex items-center justify-between">
                <span class="tag">{f.quando}</span>
                <span class="font-display text-[1.6rem] leading-none text-brand/50" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </span>
              <svg viewBox="0 0 240 150" class="mx-auto mt-5 h-auto w-[72%] max-w-[12rem] text-brand" aria-hidden="true">
                <g fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.cima} />
                  <path d={p.baixo} />
                  <path d={p.boca} />
                </g>
              </svg>
              <h3 class="fase-titulo mt-5 font-display uppercase">{f.titulo}</h3>
              <p class="mt-2 text-[0.95rem] leading-snug text-ink-soft">{f.texto}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .fases {
    grid-template-columns: minmax(0, 1fr);
  }
  .f-foto {
    aspect-ratio: 1 / 1;
  }
  @media (min-width: 640px) {
    .fases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .f-foto {
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }
  @media (min-width: 1024px) {
    .fases {
      grid-template-columns: 1.1fr 1fr 1fr;
    }
  }
  @media (min-width: 1280px) {
    .fases {
      grid-template-columns: 0.95fr 1fr 1fr 1fr 1fr;
    }
    .f-foto {
      grid-row: auto;
    }
  }
  .fase-titulo {
    font-size: clamp(1.75rem, 1.5rem + 0.7vw, 2.15rem);
    line-height: 0.9;
  }
</style>
