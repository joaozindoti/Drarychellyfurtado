---
// Preenchimento labial, dia a dia: a partir do carrossel da própria Dra. ("O que esperar depois do
// preenchimento labial?"). A arte dela aparece inteira (quadrada, sem o "arraste para o lado") ao lado do
// título; embaixo, as fases em cards de tom claro com o desenho de traço dos lábios, cada vez menos inchados.
// A fase "Dias 1 e 2" não está nas artes recebidas (falta o slide 1); o texto é o que as outras fases deixam
// implícito. Confirmar com a Dra.
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import foto from "../assets/img/labial-aplicacao.jpg";
import { whatsappProcedimento } from "../config/site";

// Altura do lábio de cima e de baixo (px no viewBox 240x150), do mais inchado ao resultado final.
const FASES = [
  { quando: "Dias 1 e 2", titulo: "Inchou? É normal.", texto: "Inchaço e, às vezes, pequenos roxos.", cima: 54, baixo: 68, cor: "coral" },
  { quando: "Dias 3 a 7", titulo: "Desinchando.", texto: "O inchaço já diminui bastante.", cima: 44, baixo: 57, cor: "peach" },
  { quando: "Dias 9 e 10", titulo: "Fase do amor.", texto: "Tem gente que sente falta de mais inchaço.", cima: 36, baixo: 48, cor: "lilac" },
  { quando: "14 dias", titulo: "Resultado real.", texto: "Agora dá para avaliar o efeito final.", cima: 31, baixo: 42, cor: "sage" },
];

const Y = 76;
const labios = (a: number, b: number) => ({
  cima: `M14 ${Y} C 50 ${Y - 6} 72 ${Y - a} 100 ${Y - a} C 109 ${Y - a} 115 ${Y - a + 6} 120 ${Y - a + 10} C 125 ${Y - a + 6} 131 ${Y - a} 140 ${Y - a} C 168 ${Y - a} 190 ${Y - 6} 226 ${Y}`,
  baixo: `M14 ${Y} C 52 ${Y + b * 0.3} 78 ${Y + b} 120 ${Y + b} C 162 ${Y + b} 188 ${Y + b * 0.3} 226 ${Y}`,
  boca: `M20 ${Y} C 64 ${Y + 4} 96 ${Y - 3} 120 ${Y + 1} C 144 ${Y - 3} 176 ${Y + 4} 220 ${Y}`,
});
---

<section id="labial" class="band bg-blush-wash" aria-labelledby="labial-titulo">
  <div class="wrap grid items-center gap-6 md:gap-8 lg:grid-cols-[minmax(0,1fr)_clamp(22rem,32vw,28rem)] lg:gap-14">
    <div>
      <h2 id="labial-titulo" class="h-section max-w-[13ch] lg:max-w-none">Preenchimento labial, dia a dia</h2>
      <p class="lead mt-4 max-w-[28rem] md:mt-5">Inchou? É normal. Veja o que esperar em cada fase.</p>
      <a href={whatsappProcedimento("preenchimento labial")} target="_blank" rel="noopener" class="btn-line mt-6">
        Quero fazer meu labial
        <Icon name="arrowUpRight" class="size-[1.1rem]" />
      </a>
    </div>

    <!-- A arte inteira dela (quadrada) -->
    <div class="media bg-[#f6b9b2]">
      <Picture
        src={foto}
        formats={["avif", "webp"]}
        widths={[400, 600, 800, 1080]}
        sizes="(min-width: 1024px) 28rem, calc(100vw - 2rem)"
        alt="Arte da Dra. Rychelly: “O que esperar depois do preenchimento labial?”. Ela, de jaleco branco e luvas, aplica o preenchimento nos lábios com uma seringa"
        loading="lazy"
        decoding="async"
        class="block aspect-square w-full"
      />
    </div>
  </div>

  <ol class="fases wrap mt-6 grid grid-cols-2 gap-3 md:mt-10 md:gap-4 lg:grid-cols-4" aria-label="Fases da recuperação">
    {
      FASES.map((f, i) => {
        const p = labios(f.cima, f.baixo);
        return (
          <li class="fase card flex flex-col" style={`background:var(--soft-${f.cor})`}>
            <span class="flex items-center justify-between gap-2">
              <span class="tag">{f.quando}</span>
              <span class="fase-num font-display text-[1.6rem] leading-none text-brand/50" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
            </span>
            <svg viewBox="0 0 240 150" class="fase-labios mx-auto h-auto text-brand" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.cima} />
                <path d={p.baixo} />
                <path d={p.boca} />
              </g>
            </svg>
            <h3 class="fase-titulo font-display uppercase">{f.titulo}</h3>
            <p class="fase-texto mt-1.5 text-ink-soft">{f.texto}</p>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .fase {
    padding: 1rem;
  }
  .fase-labios {
    width: 86%;
    max-width: 11rem;
    margin-top: 0.9rem;
  }
  .fase-titulo {
    margin-top: 0.9rem;
    font-size: clamp(1.4rem, 1.2rem + 0.7vw, 2rem);
    line-height: 0.9;
  }
  .fase-texto {
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .fase-num {
    display: none;
  }
  @media (min-width: 640px) {
    .fase {
      padding: 1.5rem;
    }
    .fase-num {
      display: block;
    }
    .fase-texto {
      font-size: 0.95rem;
    }
  }
</style>
