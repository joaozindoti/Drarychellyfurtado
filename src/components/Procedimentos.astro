---
// Procedimentos: seção branca com cards #f5f5f7 (28px, sem sombra). Cada linha é um link para o WhatsApp
// com a mensagem pronta citando o procedimento. Rosto ocupa a largura toda; Pele e Corpo lado a lado.
import Icon from "./Icon.astro";
import { GRUPOS } from "../data/procedimentos";
import { whatsappProcedimento } from "../config/site";
---

<section id="procedimentos" class="band" aria-labelledby="proc-titulo">
  <div class="wrap">
    <h2 id="proc-titulo" class="t-section" data-reveal>Procedimentos.</h2>
    <p class="t-lead mt-4 max-w-[36rem] text-slate md:mt-5" data-reveal>
      Do rosto ao corpo. Escolha o que quer cuidar e a conversa já começa pelo procedimento certo.
    </p>

    <div class="mt-10 grid gap-5 md:mt-14 md:grid-cols-2">
      {
        GRUPOS.map((g, gi) => (
          <article
            class:list={["card bg-mist p-7 md:p-10", gi === 0 && "md:col-span-2"]}
            aria-labelledby={`grupo-${g.id}`}
            data-reveal
            style={`--d: ${gi}`}
          >
            <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 id={`grupo-${g.id}`} class="t-feature">
                {g.titulo}.
              </h3>
              <p class="t-kicker text-slate">{g.frase}</p>
            </header>

            <ul class:list={["proc-list mt-6 md:mt-8", gi === 0 && "md:grid md:grid-cols-2 md:gap-x-12"]}>
              {g.itens.map((p) => (
                <li>
                  <a
                    href={whatsappProcedimento(p.mensagem)}
                    target="_blank"
                    rel="noopener"
                    class="proc-row group"
                    aria-label={`${p.nome}: agendar avaliação pelo WhatsApp (abre em nova aba)`}
                  >
                    <span class="min-w-0">
                      <span class="block text-[17px] font-semibold leading-[1.24]">
                        {p.nome}
                        {p.assinatura && <span class="t-signature ml-1.5 align-[0.12em]">Assinatura</span>}
                      </span>
                      <span class="t-small mt-1 block text-slate">{p.descricao}</span>
                    </span>
                    <Icon name="caretRight" class="proc-chev size-3.5 shrink-0" />
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proc-list li {
    box-shadow: inset 0 1px 0 var(--color-hairline);
  }
  .proc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.125rem;
    border-radius: 10px;
  }
  /* O <svg> do ícone entra por set:html, sem o atributo de escopo: daí o :global. */
  .proc-row :global(.proc-chev) {
    color: var(--color-steel);
    transition:
      transform 0.3s var(--ease-apple),
      color 0.2s;
  }
  .proc-row:hover :global(.proc-chev) {
    color: var(--color-accent);
    transform: translateX(3px);
  }
  .proc-row:hover > span > span:first-child {
    color: var(--color-accent);
  }
</style>
