---
// Rodapé enxuto no índigo da logo.
import Selo from "./Selo.astro";
import { SITE, ENDERECO_LINHA, WHATSAPP_URL } from "../config/site";

const ano = new Date().getFullYear();
---

<footer class="bg-brand pt-10 pb-[calc(6.5rem+env(safe-area-inset-bottom))] text-paper md:pb-10">
  <div class="wrap">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="flex items-center gap-3">
        <Selo class="!border-paper/30" />
        <span class="leading-tight">
          <span class="block font-bold">{SITE.nome}</span>
          <span class="block text-[0.9rem] text-paper/75">{SITE.profissao} · {ENDERECO_LINHA}</span>
        </span>
      </div>
      <nav aria-label="Rodapé" class="flex flex-wrap gap-x-5 gap-y-2 text-[0.95rem] font-bold">
        <a href="#procedimentos" class="hover:underline">Procedimentos</a>
        <a href="#antes-e-depois" class="hover:underline">Antes e depois</a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="hover:underline">WhatsApp</a>
        <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="hover:underline">Instagram</a>
      </nav>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-paper/20 pt-6 text-[0.85rem] text-paper/75 md:flex-row md:justify-between">
      <p class="max-w-[46rem]">
        As fotos de antes e depois são de pacientes reais, publicadas pela Dra. Rychelly. O resultado de cada
        procedimento depende de avaliação individual.
      </p>
      <p>© <span data-ano>{ano}</span> {SITE.marca}</p>
    </div>
  </div>
</footer>
