---
// Como é a primeira consulta: 3 cards pequenos lado a lado, em tons claros, com ícone-adesivo.
import Icon from "./Icon.astro";
import type { IconName } from "../config/icons";

const passos: { titulo: string; texto: string; icon: IconName; cor: string; r: number }[] = [
  {
    titulo: "Você chama no WhatsApp",
    texto: "Conta o que gostaria de melhorar e marca o horário que fica bom para você.",
    icon: "chats",
    cor: "paper",
    r: -6,
  },
  {
    titulo: "Avaliação com calma",
    texto: "Olho o seu rosto como um todo e explico o que faz sentido para você. E o que não faz.",
    icon: "clipboard",
    cor: "lilac",
    r: 5,
  },
  {
    titulo: "Tudo combinado antes",
    texto: "Você sabe o que vai ser feito e como é a recuperação antes de começar.",
    icon: "handHeart",
    cor: "peach",
    r: -4,
  },
];
---

<section id="como-funciona" class="band bg-lilac-wash" aria-labelledby="como-titulo">
  <div class="wrap">
    <h2 id="como-titulo" class="h-section max-w-[12ch] md:max-w-none">Como é a primeira consulta</h2>

    <ol class="mt-8 grid gap-3.5 md:mt-10 md:grid-cols-3 md:gap-4">
      {
        passos.map((m, i) => (
          <li class="card relative flex flex-col gap-8 p-5 md:p-7" style={`background:var(--soft-${m.cor})`}>
            <div class="flex items-center justify-between">
              <span class="chip-icon" style={`--r:${m.r}deg`}>
                <Icon name={m.icon} class="size-6" />
              </span>
              <span class="font-display text-[2.4rem] leading-none text-brand/40" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <div>
              <h3 class="text-[1.4rem] leading-tight tracking-[-0.02em] md:text-[1.55rem]">{m.titulo}</h3>
              <p class="mt-2.5 text-ink-soft">{m.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
