---
// Hero (faixa lilás clara): display condensado, apoio curto, CTA + secundário, os procedimentos mais
// procurados em etiquetas (para ficar claro de cara o que ela faz) e o retrato de estúdio num card
// arredondado com contorno. Poucos adesivos e giro pequeno: é Slush, só que mais sério.
// Grade: no celular o título fica lado a lado com a foto (foto menor, à direita) e o resto vem embaixo;
// do desktop para cima, todo o texto à esquerda e a foto à direita.
import { Picture } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import Icon from "./Icon.astro";
import Sticker from "./Sticker.astro";
import retrato from "../assets/img/hero-retrato.jpg";
import { SITE } from "../config/site";

const DESTAQUES = ["Botox", "Preenchimento labial", "Rinomodelação", "Bioestimulador", "Golden Bum"];
---

<section id="topo" class="hero relative overflow-hidden bg-lilac-wash">
  <div class="hero-grid wrap pt-[5.5rem] pb-9 md:pt-28 md:pb-12 lg:pt-28 lg:pb-14">
    <p class="h-tag hero-fade tag" style="--i:0">
      <Icon name="sealCheck" class="size-4 text-brand" />
      {SITE.profissao} · {SITE.endereco.cidade}-{SITE.endereco.uf}
    </p>

    <div class="h-titulo">
      <h1 class="display hero-h1">
        <span class="hero-line l-1" style="--i:0">Realce</span>
        <span class="hero-line l-2" style="--i:1">o que</span>
        <span class="hero-line" style="--i:2">já é seu.</span>
      </h1>
    </div>

    <!-- Retrato num card arredondado com contorno -->
    <div class="h-foto hero-fade relative" style="--i:1">
      <div class="media hero-media relative bg-[#4a4542]">
        <Picture
          src={retrato}
          formats={["avif", "webp"]}
          widths={[240, 360, 480, 683]}
          sizes="(min-width: 1024px) 25.5rem, 46vw"
          alt={`${SITE.nome} sorrindo, de blazer lilás, com as mãos apoiadas sob o queixo, em estúdio de fundo cinza`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[45%_30%]"
        />
        <!-- Etiqueta presa na foto (só onde a foto é grande o bastante) -->
        <span class="photo-label absolute bottom-5 left-5 z-[1]">
          <span class="grid size-8 place-items-center rounded-full bg-brand text-coral"><Icon name="butterfly" class="size-[1.1rem]" /></span>
          <span class="leading-tight">
            <span class="block text-[0.95rem] font-bold">{SITE.nome}</span>
            <span class="block text-[0.8rem] text-ink-soft">{SITE.profissao}</span>
          </span>
        </span>
      </div>

      <Sticker icon="butterfly" color="brand" shape="circle" size={4.2} rotate={-8} class="hero-pop st-a absolute z-[2]" style="--i:0" />
      <Sticker icon="sparkle" color="champagne" size={3.3} rotate={7} class="hero-pop st-b absolute z-[2] max-lg:hidden" style="--i:1" />
      <Sticker icon="heart" color="peach" shape="circle" size={3} rotate={-6} class="hero-pop st-c absolute z-[2] max-lg:hidden" style="--i:2" />
    </div>

    <p class="h-texto hero-fade max-w-[31rem] text-[0.94rem] leading-[1.45] md:text-[1.05rem]" style="--i:2">
      Harmonização facial, labial, pele e corpo com a {SITE.nome}. Para você se olhar no espelho e se reconhecer,
      só que no seu melhor.
    </p>
    <div class="h-ctas hero-fade flex flex-wrap items-center gap-3" style="--i:3">
      <CtaButton id="cta-hero" />
      <a href="#antes-e-depois" class="btn-line">
        Ver antes e depois
        <Icon name="arrowDown" class="size-[1.1rem]" />
      </a>
    </div>

    <ul class="h-tags hero-fade flex flex-wrap gap-2" style="--i:4" aria-label="Procedimentos mais procurados">
      {DESTAQUES.map((d) => <li class="tag bg-paper/70">{d}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 46%;
    grid-template-areas:
      "tag tag"
      "titulo foto"
      "texto texto"
      "ctas ctas"
      "tags tags";
    column-gap: 1rem;
    align-items: center;
  }
  .h-tag {
    grid-area: tag;
    justify-self: start;
    margin-bottom: 1.1rem;
  }
  .h-titulo {
    grid-area: titulo;
    container-type: inline-size;
  }
  .h-foto {
    grid-area: foto;
  }
  .h-texto {
    grid-area: texto;
    margin-top: 1.4rem;
  }
  .h-ctas {
    grid-area: ctas;
    margin-top: 1.25rem;
  }
  .h-tags {
    grid-area: tags;
    margin-top: 1.4rem;
  }

  /* Display: a fonte acompanha a largura da coluna do título (container query), então nunca quebra palavra.
     No celular são 3 linhas ("JÁ É SEU." mede ~3,5em); do desktop para cima, 2 linhas ("REALCE O QUE" ~4,2em). */
  .hero-h1 .hero-line {
    display: block;
  }
  .hero-h1 {
    font-size: min(27cqi, 5.6rem);
    /* 0,98 e não 0,84: os acentos do "JÁ É" encostavam na linha de cima. */
    line-height: 0.98;
    margin-left: -0.03em;
  }

  .hero-media {
    aspect-ratio: 4 / 5;
    border-radius: 24px;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 42%;
      column-gap: 2rem;
    }
    .h-tag {
      margin-bottom: 1.5rem;
    }
    .h-texto {
      margin-top: 2rem;
    }
    .h-ctas {
      margin-top: 1.5rem;
    }
    .h-tags {
      margin-top: 1.6rem;
    }
    .hero-media {
      border-radius: var(--radius-media);
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) clamp(19rem, 28vw, 25.5rem);
      grid-template-rows: auto auto auto auto 1fr;
      grid-template-areas:
        "tag foto"
        "titulo foto"
        "texto foto"
        "ctas foto"
        "tags foto";
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .h-foto {
      align-self: center;
    }
    .h-titulo {
      align-self: end;
    }
    /* Duas linhas: "REALCE O QUE" / "JÁ É SEU." */
    .hero-h1 .l-1,
    .hero-h1 .l-2 {
      display: inline-block;
    }
    .hero-h1 {
      font-size: min(17cqi, 7.4rem);
    }
  }

  /* Estilo com escopo vence a utilidade do Tailwind: o display fica aqui, só do desktop para cima. */
  .photo-label {
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
  }
  @media (min-width: 1024px) {
    .photo-label {
      display: inline-flex;
    }
  }

  /* Adesivos em volta do retrato (posições à mão, nunca em grade). No celular fica só a borboleta, menor. */
  .hero :global(.st-a) {
    right: -0.35rem;
    top: -0.9rem;
    transform: scale(0.62);
    transform-origin: top right;
  }
  @media (min-width: 1024px) {
    .hero :global(.st-a) {
      right: auto;
      left: -2.1rem;
      top: 2rem;
      transform: none;
    }
    .hero :global(.st-b) {
      right: -1.4rem;
      top: -1.1rem;
    }
    .hero :global(.st-c) {
      right: -1.2rem;
      bottom: 28%;
    }
  }
</style>
