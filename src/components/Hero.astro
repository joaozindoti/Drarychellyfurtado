---
// Hero no estilo "lançamento de produto": rótulo, título grande centralizado e, logo abaixo, o retrato de
// estúdio como o "produto" no palco, sem card em volta (só o raio de 28px da mídia). Uma cápsula branca
// flutua sobre a parte de baixo da foto com a chamada de agendamento.
// Direção de arte: no celular o retrato quadrado original; do tablet para cima, o palco 2:1.
import { getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { SITE, WHATSAPP_URL, CTA_LABEL } from "../config/site";
import retrato from "../assets/img/hero-retrato.jpg";
import palco from "../assets/img/hero-palco.jpg";

const fmt = async (src: ImageMetadata, widths: number[], format: "avif" | "webp" | "jpg") =>
  (await getImage({ src, widths, format, quality: format === "avif" ? 60 : 78 })).srcSet.attribute;

const W_PALCO = [960, 1280, 1708];
const W_RETRATO = [480, 640, 854];
const palcoAvif = await fmt(palco, W_PALCO, "avif");
const palcoWebp = await fmt(palco, W_PALCO, "webp");
const retratoAvif = await fmt(retrato, W_RETRATO, "avif");
const retratoWebp = await fmt(retrato, W_RETRATO, "webp");
const fallback = await getImage({ src: retrato, width: 854, format: "jpg", quality: 80 });
const SIZES_PALCO = "(min-width: 1348px) 1260px, calc(100vw - 2 * var(--gutter))";
const SIZES_RETRATO = "calc(100vw - 2rem)";
---

<section id="topo" class="hero overflow-hidden pb-[var(--section-gap)] pt-[clamp(2.75rem,1.5rem+4vw,5.5rem)]" aria-labelledby="hero-titulo">
  <div class="wrap text-center">
    <p class="t-kicker hero-in" style="--i: 0">{SITE.profissao}</p>
    <h1 id="hero-titulo" class="t-hero hero-in mx-auto mt-3 max-w-[16ch] md:mt-4" style="--i: 1">
      Transforme a pele em seu melhor filtro.
    </h1>
    <p class="t-lead hero-in mx-auto mt-5 max-w-[38rem] text-ink md:mt-6" style="--i: 2">
      Harmonização facial, cuidados com a pele e corpo com a {SITE.nome}, em Pedreiras&#8209;MA.
    </p>
    <div class="hero-in mt-7 flex flex-wrap items-center justify-center gap-x-7 gap-y-4 md:mt-8" style="--i: 3">
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn" aria-label={`${CTA_LABEL} pelo WhatsApp (abre em nova aba)`}>
        {CTA_LABEL}
      </a>
      <a href="#resultados" class="link text-[17px] md:text-[19px]">
        Ver resultados <Icon name="caretRight" class="chev" />
      </a>
    </div>
  </div>

  <div class="wrap-wide hero-in mt-12 md:mt-16" style="--i: 4">
    <div class="relative">
      <div class="frame bg-[#4a4542]">
        <picture>
          <source media="(min-width: 768px)" type="image/avif" srcset={palcoAvif} sizes={SIZES_PALCO} />
          <source media="(min-width: 768px)" type="image/webp" srcset={palcoWebp} sizes={SIZES_PALCO} />
          <source type="image/avif" srcset={retratoAvif} sizes={SIZES_RETRATO} />
          <source type="image/webp" srcset={retratoWebp} sizes={SIZES_RETRATO} />
          <img
            src={fallback.src}
            width="854"
            height="854"
            alt={`${SITE.nome} sorrindo, de blazer lilás, com as mãos apoiadas sob o queixo, em estúdio de fundo cinza`}
            class="hero-img block aspect-square w-full object-cover md:aspect-[2/1]"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <!-- Cápsula flutuante: sobre a foto no desktop, logo abaixo dela no celular. -->
      <div class="callout mx-auto mt-4 md:absolute md:inset-x-0 md:bottom-7 md:mt-0">
        <div class="min-w-0 text-left">
          <p class="text-[14px] font-semibold leading-[1.29] tracking-[-0.016em]">Avaliação pelo WhatsApp</p>
          <p class="t-fine mt-0.5 text-slate">{SITE.endereco.cidade}-{SITE.endereco.uf} · {SITE.telefoneExibicao}</p>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-sm shrink-0" aria-label="Agendar pelo WhatsApp (abre em nova aba)">
          Agendar
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: fit-content;
    max-width: calc(100% - 1rem);
    padding: 0.75rem 0.75rem 0.75rem 1.5rem;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow: 0 0 0 1px var(--color-control);
  }
  @media (min-width: 768px) {
    .callout {
      box-shadow: none;
    }
  }
  /* Celular: o rosto fica no terço de cima do quadrado; nada a ajustar. Desktop: palco já composto. */

  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 1.1s var(--ease-apple) both;
      animation-delay: calc(var(--i) * 110ms + 80ms);
    }
    .hero-img {
      animation: hero-zoom 1.8s var(--ease-out-soft) both;
      animation-delay: 0.45s;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.04);
    }
  }
</style>
