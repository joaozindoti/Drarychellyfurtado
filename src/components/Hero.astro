---
// Hero (faixa lilás clara): display condensado enorme, apoio curto, CTA + secundário, os procedimentos mais
// procurados em etiquetas (para ficar claro de cara o que ela faz) e o retrato de estúdio num card
// arredondado com contorno. Poucos adesivos e giro pequeno: é Slush, só que mais sério.
import { Picture } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import Icon from "./Icon.astro";
import Sticker from "./Sticker.astro";
import retrato from "../assets/img/hero-retrato.jpg";
import { SITE } from "../config/site";

const DESTAQUES = ["Botox", "Preenchimento labial", "Rinomodelação", "Bioestimulador", "Golden Bum"];
---

<section id="topo" class="hero relative overflow-hidden bg-lilac-wash">
  <div
    class="wrap grid grid-cols-1 items-center gap-y-10 pt-[5.75rem] pb-12 md:pt-28 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-x-14 lg:pt-32 lg:pb-16 xl:gap-x-24"
  >
    <!-- Texto -->
    <div class="hero-copy relative">
      <p class="hero-fade tag mb-5 md:mb-7" style="--i:0">
        <Icon name="sealCheck" class="size-4 text-brand" />
        {SITE.profissao} · {SITE.endereco.cidade}-{SITE.endereco.uf}
      </p>
      <h1 class="display hero-h1">
        <span class="hero-line" style="--i:0">Realce o que</span>
        <span class="hero-line" style="--i:1">já é seu.</span>
      </h1>

      <p class="hero-fade mt-6 max-w-[33rem] text-[1.08rem] leading-[1.45] md:mt-8 md:text-[1.25rem]" style="--i:1">
        Harmonização facial, labial, pele e corpo com a {SITE.nome}. Para você se olhar no espelho e se reconhecer,
        só que no seu melhor.
      </p>
      <div class="hero-fade mt-6 flex flex-wrap items-center gap-3 md:mt-8" style="--i:2">
        <CtaButton id="cta-hero" />
        <a href="#antes-e-depois" class="btn-line">
          Ver antes e depois
          <Icon name="arrowDown" class="size-[1.1rem]" />
        </a>
      </div>

      <ul class="hero-fade mt-7 flex flex-wrap gap-2 md:mt-9" style="--i:3" aria-label="Procedimentos mais procurados">
        {DESTAQUES.map((d) => <li class="tag bg-paper/70">{d}</li>)}
      </ul>
    </div>

    <!-- Retrato num card arredondado com contorno -->
    <div class="hero-fade relative mx-auto w-full max-w-[26rem] lg:mx-0 lg:w-[clamp(19rem,26vw,25rem)]" style="--i:2">
      <div class="media hero-media relative bg-[#4a4542]">
        <Picture
          src={retrato}
          formats={["avif", "webp"]}
          widths={[360, 480, 683]}
          sizes="(min-width: 1024px) 25rem, min(92vw, 26rem)"
          alt={`${SITE.nome} sorrindo, de blazer lilás, com as mãos apoiadas sob o queixo, em estúdio de fundo cinza`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <!-- Etiqueta presa na foto -->
        <span class="photo-label absolute bottom-4 left-4 z-[1] md:bottom-5 md:left-5">
          <span class="grid size-8 place-items-center rounded-full bg-brand text-coral"><Icon name="butterfly" class="size-[1.1rem]" /></span>
          <span class="leading-tight">
            <span class="block text-[0.95rem] font-bold">{SITE.nome}</span>
            <span class="block text-[0.8rem] text-ink-soft">{SITE.profissao}</span>
          </span>
        </span>
      </div>

      <Sticker icon="butterfly" color="brand" shape="circle" size={4.4} rotate={-8} class="hero-pop st-a absolute z-[2]" style="--i:0" />
      <Sticker icon="sparkle" color="champagne" size={3.5} rotate={7} class="hero-pop st-b absolute z-[2]" style="--i:1" />
      <Sticker icon="heart" color="peach" shape="circle" size={3.1} rotate={-6} class="hero-pop st-c absolute z-[2]" style="--i:2" />
    </div>
  </div>
</section>

<style>
  /* Display enorme: a fonte acompanha a largura da coluna (container query), então nunca quebra palavra.
     "REALCE O QUE" mede ~4,2em nesta fonte. */
  .hero-copy {
    container-type: inline-size;
  }
  .hero-h1 {
    font-size: min(21cqi, 9.4rem);
    /* 0,98 e não 0,84: os acentos do "JÁ É" encostavam na linha de cima. */
    line-height: 0.98;
    margin-left: -0.03em;
  }

  .hero-media {
    aspect-ratio: 4 / 5;
  }

  .photo-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  /* Adesivos em volta do retrato (posições à mão, nunca em grade). */
  /* No celular os adesivos ficam dentro da margem lateral (não encostam na borda da tela). */
  .hero :global(.st-a) {
    right: -0.35rem;
    top: -1.4rem;
  }
  .hero :global(.st-b) {
    left: -0.35rem;
    top: 34%;
  }
  .hero :global(.st-c) {
    right: -0.35rem;
    bottom: 22%;
  }
  @media (min-width: 1024px) {
    .hero :global(.st-a) {
      right: auto;
      left: -2.2rem;
      top: 2.2rem;
    }
    .hero :global(.st-b) {
      left: auto;
      right: -1.5rem;
      top: -1.2rem;
    }
    .hero :global(.st-c) {
      right: -1.3rem;
      bottom: 28%;
    }
  }
</style>
