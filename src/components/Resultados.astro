---
// "Highlights" da Apple: faixa #f5f5f7, título grande com link de texto do lado oposto e uma fileira de
// cards brancos (28px, sem sombra) que vaza para a direita. Cada card tem um seletor Antes/Depois.
// Comportamento em src/scripts/rail.ts (fileira) e src/scripts/casos.ts (antes/depois).
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { CASOS } from "../data/casos";
import { WHATSAPP_URL, CTA_LABEL } from "../config/site";

const sizes = "(min-width: 768px) 420px, 84vw";
const widths = [400, 640, 840, 1000];
---

<section id="resultados" class="band bg-mist" aria-labelledby="resultados-titulo" data-reveal-group>
  <div class="wrap flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <h2 id="resultados-titulo" class="t-section" data-reveal>Resultados reais.</h2>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="link mb-1 text-[17px] md:text-[19px]" data-reveal>
      {CTA_LABEL} <Icon name="caretRight" class="chev" />
    </a>
  </div>

  <div class="rail mt-10 md:mt-12" data-rail data-reveal>
    <ul class="rail-track" data-rail-track aria-label="Casos de antes e depois">
      {
        CASOS.map((c) => (
          <li class="rail-item card flex flex-col bg-white" data-rail-item data-caso>
            <div class="px-7 pt-8 md:px-9 md:pt-10">
              <p class="t-small font-semibold">
                {c.rotulo}
                {c.assinatura && <span class="t-signature ml-1.5">Assinatura da Dra.</span>}
              </p>
              <h3 class="t-card mt-2 max-w-[17ch]">{c.titulo}</h3>
              <p class="t-small mt-2.5 text-slate">{c.texto}</p>

              <div class="seg mt-6" role="group" aria-label={`Ver ${c.rotulo}: antes ou depois`}>
                <button type="button" class="seg-btn" aria-pressed="true" data-ver="antes">
                  Antes
                </button>
                <button type="button" class="seg-btn" aria-pressed="false" data-ver="depois">
                  Depois
                </button>
                <span class="seg-thumb" aria-hidden="true" />
              </div>
            </div>

            <div class="caso-media relative mt-7 aspect-square w-full overflow-hidden" data-estado="antes">
              <Picture
                src={c.depois}
                formats={["avif", "webp"]}
                widths={widths.filter((w) => w <= c.depois.width)}
                sizes={sizes}
                alt={c.altDepois}
                loading="lazy"
                decoding="async"
                class="caso-depois absolute inset-0 h-full w-full object-cover"
                style={c.foco ? `object-position: ${c.foco}` : undefined}
              />
              <Picture
                src={c.antes}
                formats={["avif", "webp"]}
                widths={widths.filter((w) => w <= c.antes.width)}
                sizes={sizes}
                alt={c.altAntes}
                loading="lazy"
                decoding="async"
                class="caso-antes absolute inset-0 h-full w-full object-cover"
                style={c.foco ? `object-position: ${c.foco}` : undefined}
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap mt-7 flex items-center justify-between gap-6 md:mt-8">
    <p class="t-fine max-w-[34rem] text-slate">
      Pacientes reais da Dra. Rychelly, em fotos publicadas por ela. Resultados variam de pessoa para pessoa e
      dependem de avaliação.
    </p>
    <div class="rail-ctrl" data-rail-ctrl>
      <button type="button" class="rail-btn" data-rail-prev aria-label="Caso anterior">
        <Icon name="caretLeft" class="size-3.5" />
      </button>
      <div class="flex items-center gap-2 px-1" aria-hidden="true">
        {CASOS.map((_, i) => <span class="rail-dot" data-rail-dot={i} />)}
      </div>
      <button type="button" class="rail-btn" data-rail-next aria-label="Próximo caso">
        <Icon name="caretRight" class="size-3.5" />
      </button>
    </div>
  </div>
</section>

<style>
  .rail {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail-track {
    display: flex;
    gap: 20px;
    width: max-content;
    padding-inline: var(--edge);
  }
  .rail-item {
    width: min(84vw, 420px);
    scroll-snap-align: start;
  }

  /* Seletor segmentado no estilo dos controles da Apple: trilho translúcido e um "polegar" branco que desliza. */
  .seg {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border-radius: 9999px;
    background: rgba(210, 210, 215, 0.64);
  }
  .seg-btn {
    position: relative;
    z-index: 1;
    min-width: 5.25rem;
    min-height: 34px;
    padding: 0 1rem;
    border-radius: 9999px;
    font-size: 14px;
    letter-spacing: -0.016em;
    color: rgba(0, 0, 0, 0.56);
    transition: color 0.3s var(--ease-apple);
  }
  .seg-btn[aria-pressed="true"] {
    color: var(--color-ink);
    font-weight: 600;
  }
  .seg-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 9999px;
    background: #fff;
    transition: transform 0.45s var(--ease-apple);
  }
  [data-caso][data-ver-atual="depois"] .seg-thumb {
    transform: translateX(100%);
  }

  /* As <img> vêm do componente Picture, por isso :global. */
  .caso-media :global(.caso-antes) {
    transition: opacity 0.6s var(--ease-apple);
  }
  .caso-media[data-estado="depois"] :global(.caso-antes) {
    opacity: 0;
  }

  .rail-ctrl {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 36px;
    background: rgba(210, 210, 215, 0.64);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
  .rail-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    color: rgba(0, 0, 0, 0.56);
    transition:
      background-color 0.2s,
      opacity 0.2s;
  }
  .rail-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.6);
  }
  .rail-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .rail-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.42);
    transition:
      width 0.4s var(--ease-apple),
      background-color 0.4s;
  }
  .rail-dot[data-active] {
    width: 24px;
    background: rgba(0, 0, 0, 0.8);
  }
</style>
